# Copy this file to `.env` for local development.
# On Vercel, add the same keys in Project → Settings → Environment Variables.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/maxbuild?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Pass@123

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) for Career Applications -> info@maxbuildinfra.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@maxbuildinfra.com
SMTP_PASS=your-app-password
SMTP_FROM="MaxBuild Careers <your-email@maxbuildinfra.com>"
CAREERS_EMAIL_TO=info@maxbuildinfra.com

PORT=8787
